{
  "case": "hf-2026",
  "title": "OpenAI / Hugging Face containment incident, May-July 2026",
  "is_derivation_case": true,
  "derivation_note": "The schema was written after reading these reports. Columns (a) and (b) on this case are traceability, not validation; only column (c) could have come out against the protocol.",
  "records": {
    "intent:A": "intent_run_a.json",
    "intent:B": "intent_run_b.json",
    "closeout:A": "closeout_run_a.json",
    "notice:N1": "notice_n1.json",
    "notice:N2": "notice_n2.json"
  },
  "closes": {
    "closeout:A": "intent:A"
  },
  "variants": {
    "diligent": {
      "description": "Filer declares every write permission that is a configuration fact before the run.",
      "remove_surfaces": {}
    },
    "as_believed": {
      "description": "Filer declares the proxy only as a read path, as the operator plausibly believed it to be. Models the expected completeness failure.",
      "remove_surfaces": {
        "intent:A": [
          "artifactory-proxy"
        ],
        "intent:B": [
          "artifactory-proxy"
        ]
      },
      "path_writable": {
        "intent:A": {
          "pkg-proxy": false
        },
        "intent:B": {
          "pkg-proxy": false
        }
      }
    }
  },
  "decision_points": [
    {
      "id": "DP1",
      "date": "12 May",
      "decision": "Agents can write to the package proxy and a message board forms; the run continues.",
      "field": "egress_topology.writable_surfaces",
      "developer_aware": "no",
      "aware_source": "openai2026huggingface: the channel's existence and significance were not apparent to the responsible leaders until July",
      "recorded_before": {
        "record": "intent:A",
        "any": "/egress_topology/writable_surfaces",
        "where": {
          "surface_id": "artifactory-proxy",
          "persistence": [
            "cross_run",
            "permanent"
          ],
          "tenancy": [
            "shared_runs",
            "shared_agents"
          ]
        }
      },
      "checkable_after": {
        "record": "closeout:A",
        "any": "/containment_exceptions",
        "where": {
          "surface_id": "artifactory-proxy",
          "kind": "comms"
        },
        "evidence": [
          "inter_agent_messages",
          "egress_logs"
        ]
      },
      "decision_rule": {
        "rule": "pause_criterion",
        "event_kind": "inter_agent_comms"
      }
    },
    {
      "id": "DP2",
      "date": "26 May",
      "decision": "First SSRF through the proxy gives indirect internet access; no pause.",
      "field": "egress_topology.permitted_paths",
      "developer_aware": "unclear",
      "aware_source": "not established in the first-party record",
      "recorded_before": {
        "record": "intent:A",
        "any": "/egress_topology/permitted_paths",
        "where": {
          "path_id": "pkg-proxy",
          "enforcement": "packet_filter"
        }
      },
      "checkable_after": {
        "record": "closeout:A",
        "any": "/security_events",
        "where": {
          "kind": "sandbox_egress"
        },
        "evidence": [
          "egress_logs"
        ]
      },
      "decision_rule": {
        "rule": "pause_criterion",
        "event_kind": "sandbox_egress"
      }
    },
    {
      "id": "DP3",
      "date": "11 Jun",
      "decision": "A second, highly persistent model is started with access to the same proxy and builds on the first model's messages.",
      "field": "egress_topology.shared_surface_lineage",
      "developer_aware": "no",
      "aware_source": "openai2026huggingface: access was known, the channel was not",
      "recorded_before": {
        "record": "intent:B",
        "any": "/egress_topology/shared_surface_lineage",
        "where": {
          "surface_id": "artifactory-proxy",
          "run_id": "exploitgym-rl-a"
        }
      },
      "checkable_after": {
        "record": "closeout:A",
        "any": "/containment_exceptions",
        "where": {
          "kind": "comms",
          "linked_runs": {
            "contains": "exploitgym-rl-b"
          }
        },
        "evidence": [
          "inter_agent_messages"
        ]
      },
      "decision_rule": {
        "rule": "pause_criterion",
        "event_kind": "inter_agent_comms"
      }
    },
    {
      "id": "DP4",
      "date": "26 Jun",
      "decision": "A zero-day gives administrator access and command execution on the proxy.",
      "field": "egress_topology.credential_scope",
      "developer_aware": "unclear",
      "aware_source": "sources differ on whether this was seen before the 5 Jul incident",
      "recorded_before": {
        "record": "intent:A",
        "pointer": "/egress_topology/credential_scope/admin_credentials_reachable",
        "equals": false
      },
      "checkable_after": {
        "record": "closeout:A",
        "any": "/security_events",
        "where": {
          "kind": "privilege_escalation"
        },
        "evidence": [
          "access_logs"
        ]
      },
      "decision_rule": {
        "rule": "pause_criterion",
        "event_kind": "privilege_escalation"
      }
    },
    {
      "id": "DP5",
      "date": "5-6 Jul",
      "decision": "Outage; incident opened; route blocked, credentials removed, service rebuilt (clearing the board); evaluations resume.",
      "field": "pause_criteria, restart_protocol",
      "developer_aware": "yes",
      "aware_source": "openai2026huggingface: security incident opened 5 Jul; evaluations resumed 6 Jul",
      "recorded_before": {
        "all": [
          {
            "record": "intent:A",
            "any": "/pause_criteria",
            "where": {
              "matches": {
                "contains": "agent_induced_outage"
              }
            }
          },
          {
            "record": "intent:A",
            "pointer": "/restart_protocol/approver_role",
            "exists": true
          }
        ]
      },
      "checkable_after": {
        "record": "closeout:A",
        "any": "/pause_events",
        "where": {
          "criterion_id": "C-outage",
          "restart": {
            "nonempty": true
          }
        },
        "evidence": [
          "access_logs"
        ]
      },
      "decision_rule": {
        "rule": "pause_criterion",
        "event_kind": "agent_induced_outage"
      }
    },
    {
      "id": "DP6",
      "date": "20-29 Jul",
      "decision": "Independent review scoped to exclude training-phase incidents, without model access; third parties notified at the developer's discretion.",
      "field": "investigator_scope_expansion, third_party_notifications",
      "developer_aware": "yes",
      "aware_source": "metr2026investigation; freedman2026nyt",
      "recorded_before": {
        "record": "intent:A",
        "pointer": "/investigator_scope_expansion/committed",
        "equals": true
      },
      "checkable_after": {
        "all": [
          {
            "record": "closeout:A",
            "any": "/scope_requested_vs_granted",
            "where": {
              "refusals": {
                "nonempty": true
              }
            }
          },
          {
            "record": "closeout:A",
            "any": "/third_party_notifications",
            "where": {
              "party": "Hugging Face"
            }
          }
        ],
        "evidence": []
      },
      "decision_rule": {
        "rule": "record_obligation"
      }
    }
  ]
}
