{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dbyr.example/schema/0.1.0/system_runtime_record.schema.json",
  "title": "SystemRuntimeRecord",
  "description": "Filed before internal deployment at scale or external exposure.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "system_id",
    "filed_at",
    "base_run_ids",
    "deployment_context",
    "inter_agent_comms_permitted",
    "signer"
  ],
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/schema_version"
    },
    "record_type": {
      "const": "SystemRuntimeRecord"
    },
    "system_id": {
      "$ref": "common.schema.json#/$defs/id",
      "x-tier": "public"
    },
    "filed_at": {
      "$ref": "common.schema.json#/$defs/timestamp",
      "x-tier": "public"
    },
    "base_run_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "common.schema.json#/$defs/id"
      },
      "x-tier": "public"
    },
    "deployment_context": {
      "enum": [
        "internal_research",
        "internal_production",
        "external"
      ],
      "x-tier": "public"
    },
    "tools_and_scaffolding": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "x-tier": "restricted"
    },
    "inference_scaling": {
      "type": "string",
      "x-tier": "restricted"
    },
    "inter_agent_comms_permitted": {
      "type": "boolean",
      "x-tier": "public"
    },
    "user_exposure": {
      "type": "string",
      "x-tier": "restricted"
    },
    "oversight_mode": {
      "type": "string",
      "x-tier": "restricted"
    },
    "recurring_eval_cadence": {
      "type": "string",
      "x-tier": "restricted"
    },
    "signer": {
      "$ref": "common.schema.json#/$defs/signer",
      "x-tier": "public"
    }
  }
}
