{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dbyr.example/schema/0.1.0/training_run_closeout.schema.json",
  "title": "TrainingRunCloseout",
  "description": "Filed on completion, abort, or every 30 days for a rolling run.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "run_id",
    "filed_at",
    "period_start",
    "period_end",
    "status",
    "security_events",
    "pause_events",
    "containment_exceptions",
    "logs_preserved_pct",
    "scope_requested_vs_granted",
    "third_party_notifications",
    "signer"
  ],
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/schema_version"
    },
    "record_type": {
      "const": "TrainingRunCloseout"
    },
    "run_id": {
      "$ref": "common.schema.json#/$defs/id",
      "x-tier": "public"
    },
    "filed_at": {
      "$ref": "common.schema.json#/$defs/timestamp",
      "x-tier": "public"
    },
    "period_start": {
      "$ref": "common.schema.json#/$defs/date",
      "x-tier": "public"
    },
    "period_end": {
      "$ref": "common.schema.json#/$defs/date",
      "x-tier": "public"
    },
    "status": {
      "enum": [
        "completed",
        "aborted",
        "paused",
        "rolling"
      ],
      "x-tier": "public"
    },
    "attested_absence": {
      "description": "Required by the adequacy profile. True asserts that no reportable event was detected; then absence_basis is required.",
      "type": "boolean",
      "x-tier": "public"
    },
    "security_events": {
      "type": "array",
      "x-tier": "restricted",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "event_id",
          "at",
          "kind",
          "description",
          "evidence"
        ],
        "properties": {
          "event_id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "at": {
            "$ref": "common.schema.json#/$defs/timestamp"
          },
          "kind": {
            "$ref": "common.schema.json#/$defs/event_kind"
          },
          "description": {
            "type": "string"
          },
          "evidence": {
            "description": "Evidence classes a V1 reconciliation would check this event against.",
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "common.schema.json#/$defs/evidence_class"
            }
          },
          "affected_parties": {
            "description": "External organisations affected. Each must appear in third_party_notifications.",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "detected_at": {
            "description": "When the developer detected the event. Starts the interim-notice and notification clocks. Required by the adequacy profile.",
            "$ref": "common.schema.json#/$defs/timestamp"
          },
          "classification_rationale": {
            "type": "string",
            "description": "Why this kind and not a neighbouring one."
          }
        }
      },
      "description": "Every event of a reportable kind (any event_kind except monitor_alert) that the developer detected in the period. Completeness is required: an empty list is a statement that none was detected."
    },
    "integrity_events": {
      "type": "array",
      "x-tier": "restricted",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "event_id",
          "at",
          "kind",
          "description",
          "evidence"
        ],
        "properties": {
          "event_id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "at": {
            "$ref": "common.schema.json#/$defs/timestamp"
          },
          "kind": {
            "$ref": "common.schema.json#/$defs/event_kind"
          },
          "description": {
            "type": "string"
          },
          "evidence": {
            "description": "Evidence classes a V1 reconciliation would check this event against.",
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "common.schema.json#/$defs/evidence_class"
            }
          },
          "affected_parties": {
            "description": "External organisations affected. Each must appear in third_party_notifications.",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "detected_at": {
            "description": "When the developer detected the event. Starts the interim-notice and notification clocks. Required by the adequacy profile.",
            "$ref": "common.schema.json#/$defs/timestamp"
          },
          "classification_rationale": {
            "type": "string",
            "description": "Why this kind and not a neighbouring one."
          }
        }
      },
      "description": "Events of kind environment_tampering or integrity_incident; same completeness duty as security_events."
    },
    "pause_events": {
      "type": "array",
      "x-tier": "restricted",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "criterion_id",
          "triggered_at",
          "triggered_by_role",
          "action_taken"
        ],
        "properties": {
          "criterion_id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "triggering_event_ids": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/id"
            }
          },
          "triggered_at": {
            "$ref": "common.schema.json#/$defs/timestamp"
          },
          "triggered_by_role": {
            "$ref": "common.schema.json#/$defs/role_ref"
          },
          "action_taken": {
            "enum": [
              "pause",
              "pause_and_review",
              "halt_and_amend_intent",
              "notify_only",
              "none"
            ]
          },
          "restart": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "approved_by_role",
                  "approved_at",
                  "evidence"
                ],
                "properties": {
                  "approved_by_role": {
                    "$ref": "common.schema.json#/$defs/role_ref"
                  },
                  "approved_at": {
                    "$ref": "common.schema.json#/$defs/timestamp"
                  },
                  "evidence": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string"
                    }
                  },
                  "intent_amended": {
                    "type": "boolean"
                  }
                }
              }
            ]
          }
        }
      }
    },
    "containment_exceptions": {
      "type": "array",
      "x-tier": "restricted",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "exception_id",
          "surface_id",
          "declared_surface",
          "kind",
          "opened_at",
          "status"
        ],
        "properties": {
          "exception_id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "surface_id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "declared_surface": {
            "description": "False when the surface was not in the Intent's egress_topology: the expected completeness failure.",
            "type": "boolean"
          },
          "kind": {
            "enum": [
              "egress",
              "comms",
              "credential",
              "write"
            ]
          },
          "opened_at": {
            "$ref": "common.schema.json#/$defs/timestamp"
          },
          "closed_at": {
            "$ref": "common.schema.json#/$defs/timestamp"
          },
          "status": {
            "enum": [
              "open",
              "closed"
            ]
          },
          "linked_runs": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/id"
            }
          }
        }
      }
    },
    "evals_planned_vs_run": {
      "type": "array",
      "x-tier": "restricted",
      "items": {
        "type": "object"
      }
    },
    "logs_preserved_pct": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "x-tier": "public",
      "description": "The weakest class: the minimum over preservation[] of sample_rate x preserved_pct. Not an average and not a share of what the developer chose to keep."
    },
    "logs_retention_confirmed": {
      "type": "boolean",
      "x-tier": "public"
    },
    "scope_requested_vs_granted": {
      "type": "array",
      "x-tier": "public",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "investigator",
          "requested",
          "granted",
          "refusals"
        ],
        "properties": {
          "investigator": {
            "type": "string"
          },
          "requested": {
            "$ref": "common.schema.json#/$defs/window"
          },
          "granted": {
            "$ref": "common.schema.json#/$defs/window"
          },
          "model_access_granted": {
            "type": "boolean"
          },
          "refusals": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "at",
                "what",
                "grounds",
                "refused_by_role"
              ],
              "properties": {
                "at": {
                  "$ref": "common.schema.json#/$defs/timestamp"
                },
                "what": {
                  "type": "string"
                },
                "grounds": {
                  "type": "string",
                  "minLength": 1
                },
                "refused_by_role": {
                  "$ref": "common.schema.json#/$defs/role_ref"
                }
              }
            }
          }
        }
      }
    },
    "third_party_notifications": {
      "description": "One entry per affected external party: whether and when it was told, or why not. Party names are restricted (naming a victim can expose an unpatched system); the counts and timing are public.",
      "type": "array",
      "x-tier": "public",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "party",
          "affected_by",
          "notified"
        ],
        "properties": {
          "party": {
            "type": "string",
            "x-tier": "restricted"
          },
          "affected_by": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "common.schema.json#/$defs/id"
            },
            "x-tier": "restricted"
          },
          "notified": {
            "type": "boolean",
            "x-tier": "public"
          },
          "notified_at": {
            "$ref": "common.schema.json#/$defs/timestamp",
            "x-tier": "public"
          },
          "channel": {
            "type": "string",
            "x-tier": "restricted"
          },
          "not_notified_reason": {
            "type": "string",
            "minLength": 1,
            "x-tier": "restricted"
          },
          "delay_reason": {
            "description": "Required by the adequacy profile when notification came later than the deadline after detection.",
            "type": "string",
            "minLength": 1,
            "x-tier": "restricted"
          }
        },
        "if": {
          "properties": {
            "notified": {
              "const": true
            }
          }
        },
        "then": {
          "required": [
            "notified_at"
          ]
        },
        "else": {
          "required": [
            "not_notified_reason"
          ]
        }
      }
    },
    "residual_risk": {
      "type": "string",
      "x-tier": "restricted"
    },
    "cleared_for_system_integration": {
      "type": "boolean",
      "x-tier": "public"
    },
    "signer": {
      "$ref": "common.schema.json#/$defs/signer",
      "x-tier": "public"
    },
    "notice_ids": {
      "description": "ExceptionNotices filed for this run during the period.",
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/id"
      },
      "x-tier": "public"
    },
    "absence_basis": {
      "type": "string",
      "x-tier": "public",
      "description": "Which monitors, at what coverage, support the absence claim."
    },
    "internal_incidents": {
      "type": "array",
      "x-tier": "restricted",
      "description": "Every internal incident ticket opened about the run, mapped to events or explained.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "incident_id",
          "opened_at"
        ],
        "properties": {
          "incident_id": {
            "type": "string"
          },
          "opened_at": {
            "$ref": "common.schema.json#/$defs/timestamp"
          },
          "closed_at": {
            "$ref": "common.schema.json#/$defs/timestamp"
          },
          "summary": {
            "type": "string"
          },
          "event_ids": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/id"
            }
          },
          "not_an_event_reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "preservation": {
      "type": "array",
      "x-tier": "public",
      "description": "Per evidence class: what share of what was generated is held.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence_class",
          "denominator",
          "sample_rate",
          "preserved_pct"
        ],
        "properties": {
          "evidence_class": {
            "$ref": "common.schema.json#/$defs/evidence_class"
          },
          "denominator": {
            "type": "string",
            "minLength": 1
          },
          "sample_rate": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "preserved_pct": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "earliest_record": {
            "$ref": "common.schema.json#/$defs/timestamp"
          }
        }
      }
    },
    "config_changes": {
      "type": "array",
      "x-tier": "restricted",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "at",
          "what",
          "intent_amended"
        ],
        "properties": {
          "at": {
            "$ref": "common.schema.json#/$defs/timestamp"
          },
          "what": {
            "type": "string",
            "minLength": 1
          },
          "intent_amended": {
            "type": "boolean"
          }
        }
      }
    },
    "surface_resets": {
      "type": "array",
      "x-tier": "restricted",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "at",
          "surface_id",
          "snapshot_retained"
        ],
        "properties": {
          "at": {
            "$ref": "common.schema.json#/$defs/timestamp"
          },
          "surface_id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "snapshot_retained": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
